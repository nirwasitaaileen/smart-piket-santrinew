                deskripsiLokasi: "Kelas X, XI, XII serta ruang baca kitab kuning.",
                anggota: ["Nirwasita Aileen", "Jennie", "Halland", "Ronaldo"],
                tugas: [
                    { id: "rab-1", teks: "Menghapus papan tulis dan menyiapkan spidol kelas", pj: "Nirwasita Aileen", selesai: true },
                    { id: "rab-2", teks: "Menyapu ruang kelas X, XI, dan XII", pj: "Jennie", selesai: true },
                    { id: "rab-3", teks: "Merapikan meja guru dan kursi belajar santri", pj: "Halland", selesai: false },
                    { id: "rab-4", teks: "Membersihkan debu rak buku di perpustakaan", pj: "Ronaldo", selesai: false }
                ]
            },
            Kamis: {
                hari: "Kamis",
                badge: "Kelompok 4",
                namaKelompok: "Kelompok Tahu Bulat",
                lokasi: "Dapur Umum & Ruang Makan",
                deskripsiLokasi: "Meja makan santri, tempat cuci piring, dan area dispenser.",
                anggota: ["Nirwasita Aileen", "Jennie", "Halland", "Ronaldo"],
                tugas: [
                    { id: "kam-1", teks: "Mengelap seluruh meja dan kursi ruang makan", pj: "Nirwasita Aileen", selesai: false },
                    { id: "kam-2", teks: "Menyapu sisa makanan dan mengepel lantai ruang makan", pj: "Jennie", selesai: false },
                    { id: "kam-3", teks: "Membersihkan bak cuci piring dan saluran air", pj: "Halland", selesai: false },
