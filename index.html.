<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Piket Santri - Dashboard Jadwal Kebersihan</title>
    <!-- Menggunakan Tailwind CSS via CDN untuk styling responsif dan rapi -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Menggunakan Google Fonts (Plus Jakarta Sans & Fraunces) agar terlihat hangat & modern -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Menggunakan Lucide Icons untuk ikon yang bersih dan jelas -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        // Konfigurasi warna kustom Tailwind yang terinspirasi dari referensi desain (Earthy Forest & Cream)
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['"Fraunces"', 'serif'],
                    },
                    colors: {
                        forest: {
                            900: '#263829', // Sidebar hijau tua
                            800: '#314734',
                            700: '#456149',
                            600: '#5D7E62', // Aksen hijau daun
                            100: '#E8EFE9',
                        },
                        cream: {
                            50: '#FAF8F3',  // Kartu utama krem terang
                            100: '#F2EDE2', // Latar belakang utama
                            200: '#E5DEC9', // Border & elemen sekunder
                            300: '#D4C9AE',
                        },
                        wood: {
                            600: '#8C6239',
                            700: '#6E4B2A',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-cream-100 text-forest-900 font-sans antialiased min-h-screen flex flex-col lg:flex-row">

    <!-- =====================================================================
         1. SIDEBAR NAVIGASI (Adaptif: Atas di Mobile, Kiri di Desktop)
         ===================================================================== -->
    <aside class="bg-forest-900 text-cream-50 w-full lg:w-72 flex-shrink-0 flex flex-col justify-between p-5 lg:p-6 shadow-xl z-20">
        <div>
            <!-- Badge / Papan Nama Aplikasi -->
            <div class="bg-wood-600 border-2 border-wood-700 rounded-2xl p-4 text-center shadow-md mb-6 relative overflow-hidden">
                <div class="flex justify-center items-center gap-1.5 text-cream-200 text-xs uppercase tracking-widest font-semibold mb-1">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                    <span>Pondok Pesantren</span>
                </div>
                <h1 class="font-serif text-2xl font-bold text-cream-50 tracking-tight">Smart Piket</h1>
                <p class="text-xs text-cream-200 mt-0.5">Santri Hebat, Lingkungan Sehat</p>
            </div>

            <!-- Navigasi Hari (Senin - Sabtu) -->
            <div class="mb-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-forest-600 px-3 mb-2">Jadwal Piket Mingguan</p>
                <nav id="day-navigation" class="grid grid-cols-3 sm:grid-cols-6 lg:grid-cols-1 gap-1.5" aria-label="Pilih Hari Piket">
                    <!-- Tombol hari akan dirender secara dinamis oleh JavaScript -->
                </nav>
            </div>
        </div>

        <!-- Kartu Tips Kebersihan (Muncul di layar besar seperti referensi) -->
        <div class="hidden lg:block bg-forest-800/80 border border-forest-700 rounded-2xl p-4 mt-8">
            <div class="flex items-center gap-2 text-amber-300 font-semibold text-sm mb-1.5">
                <i data-lucide="leaf" class="w-4 h-4"></i>
                <span>Pesan Kebersihan</span>
            </div>
            <p class="text-xs text-cream-200 leading-relaxed">
                "Kebersihan adalah sebagian dari iman." Pastikan setiap sudut ruangan bersih sebelum waktu mengaji tiba!
            </p>
        </div>
    </aside>

    <!-- =====================================================================
         2. KONTEN UTAMA (Dashboard Interaktif)
         ===================================================================== -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-6xl mx-auto w-full">
        
        <!-- Header Sapaan & Tanggal -->
        <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-5 border-b border-cream-200">
            <div>
                <div class="flex items-center gap-2 text-forest-600 text-sm font-semibold mb-1">
                    <i data-lucide="sun" class="w-4 h-4 text-amber-600"></i>
                    <span>Assalamu'alaikum, Santri!</span>
                </div>
                <h2 class="font-serif text-2xl sm:text-3xl font-bold text-forest-900">
                    Dashboard Piket Hari <span id="header-day-name" class="text-forest-600 underline decoration-cream-300 underline-offset-4">Senin</span>
                </h2>
                <p class="text-sm text-forest-700 mt-1">Pantau jadwal kelompok, lokasi tugas, dan centang pekerjaan yang sudah selesai.</p>
            </div>

            <!-- Info Waktu & Status Singkat -->
            <div class="flex items-center gap-3 bg-cream-50 px-4 py-3 rounded-2xl border border-cream-200 shadow-sm self-start sm:self-auto">
                <div class="bg-forest-100 p-2.5 rounded-xl text-forest-700">
                    <i data-lucide="calendar-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <p class="text-xs text-forest-600 font-medium">Waktu Piket Pagi</p>
                    <p class="text-sm font-bold text-forest-900">06:00 - 06:45 WIB</p>
                </div>
            </div>
        </header>

        <!-- Ringkasan Statistik (Jumlah Selesai & Belum Selesai) -->
        <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6" aria-label="Statistik Tugas Piket">
            <!-- Kartu 1: Total Tugas -->
            <div class="bg-cream-50 border border-cream-200 rounded-2xl p-4 sm:p-5 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-cream-200/70 text-forest-800 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="clipboard-list" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-forest-600">Total Tugas</p>
                    <p id="stat-total" class="text-2xl font-bold text-forest-900 mt-0.5">0</p>
                </div>
            </div>

            <!-- Kartu 2: Tugas Selesai -->
            <div class="bg-cream-50 border border-cream-200 rounded-2xl p-4 sm:p-5 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">Tugas Selesai</p>
                    <p id="stat-completed" class="text-2xl font-bold text-emerald-800 mt-0.5">0</p>
                </div>
            </div>

            <!-- Kartu 3: Belum Selesai -->
            <div class="bg-cream-50 border border-cream-200 rounded-2xl p-4 sm:p-5 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0">
                    <i data-lucide="clock" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-amber-700">Belum Selesai</p>
                    <p id="stat-pending" class="text-2xl font-bold text-amber-800 mt-0.5">0</p>
                </div>
            </div>
        </section>

        <!-- Grid Utama: Info Kelompok & Lokasi (Kiri) + Checklist Tugas (Kanan) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Kolom Kiri (5 Kolom): Informasi Kelompok & Lokasi Piket -->
            <section class="lg:col-span-5 flex flex-col gap-6">
                <div class="bg-cream-50 border border-cream-200 rounded-3xl p-5 sm:p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2">
                            <span class="p-2 bg-forest-100 text-forest-700 rounded-xl">
                                <i data-lucide="users" class="w-5 h-5"></i>
                            </span>
                            <h3 class="font-serif text-lg font-bold text-forest-900">Info Kelompok</h3>
                        </div>
                        <span id="group-badge" class="text-xs font-bold px-3 py-1 rounded-full bg-forest-600 text-cream-50">
                            Kelompok 1
                        </span>
                    </div>

                    <!-- Nama Kelompok & Lokasi -->
                    <div class="space-y-4">
                        <div class="bg-cream-100/80 border border-cream-200 rounded-2xl p-4">
                            <p class="text-xs text-forest-600 font-semibold uppercase tracking-wider mb-1">Nama Kelompok</p>
                            <p id="group-name" class="text-lg font-bold text-forest-900">Kelompok Al-Fatih</p>
                        </div>

                        <div class="bg-cream-100/80 border border-cream-200 rounded-2xl p-4">
                            <p class="text-xs text-forest-600 font-semibold uppercase tracking-wider mb-1">Lokasi Piket Utama</p>
                            <div class="flex items-start gap-2.5 mt-1">
                                <i data-lucide="map-pin" class="w-5 h-5 text-wood-600 flex-shrink-0 mt-0.5"></i>
                                <div>
                                    <p id="group-location" class="text-base font-bold text-forest-900">Asrama Putra Lt. 1 & Teras Masjid</p>
                                    <p id="group-location-desc" class="text-xs text-forest-700 mt-0.5">Area kamar santri 1-4 dan serambi depan.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Daftar Anggota Santri -->
                        <div>
                            <p class="text-xs text-forest-600 font-semibold uppercase tracking-wider mb-2.5">Anggota Bertugas</p>
                            <div id="member-list" class="grid grid-cols-2 gap-2">
                                <!-- Anggota dirender via JS -->
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Kolom Kanan (7 Kolom): Checklist Tugas Kebersihan -->
            <section class="lg:col-span-7">
                <div class="bg-cream-50 border border-cream-200 rounded-3xl p-5 sm:p-6 shadow-sm h-full flex flex-col justify-between">
                    <div>
                        <!-- Header Kartu Checklist -->
                        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                            <div class="flex items-center gap-2">
                                <span class="p-2 bg-forest-100 text-forest-700 rounded-xl">
                                    <i data-lucide="check-square" class="w-5 h-5"></i>
                                </span>
                                <div>
                                    <h3 class="font-serif text-lg font-bold text-forest-900">Checklist Tugas Piket</h3>
                                    <p class="text-xs text-forest-600">Klik tugas untuk menandai selesai</p>
                                </div>
                            </div>

                            <!-- Tombol Reset Checklist -->
                            <button id="btn-reset" type="button" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-cream-200/80 hover:bg-rose-100 text-forest-800 hover:text-rose-700 border border-cream-300 hover:border-rose-200 transition-colors cursor-pointer">
                                <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
                                <span>Reset Checklist</span>
                            </button>
                        </div>

                        <!-- Progress Bar Visual -->
                        <div class="mb-5 bg-cream-100 p-3.5 rounded-2xl border border-cream-200">
                            <div class="flex justify-between items-center text-xs font-semibold mb-1.5">
                                <span class="text-forest-700">Progres Kebersihan Hari Ini</span>
                                <span id="progress-text" class="text-forest-900 font-bold">0%</span>
                            </div>
                            <div class="w-full bg-cream-200 rounded-full h-3 overflow-hidden">
                                <div id="progress-bar" class="bg-forest-600 h-3 rounded-full transition-all duration-300 ease-out" style="width: 0%"></div>
                            </div>
                        </div>

                        <!-- Daftar Tugas (Checklist) -->
                        <div id="task-list" class="space-y-2.5" role="list">
                            <!-- Item checklist dirender via JS -->
                        </div>
                    </div>

                    <!-- Banner Apresiasi Jika Semua Selesai -->
                    <div id="all-done-banner" class="hidden mt-6 bg-emerald-50 border border-emerald-200 rounded-2xl p-4 flex items-center gap-3 text-emerald-900">
                        <div class="bg-emerald-600 text-white p-2 rounded-xl flex-shrink-0">
                            <i data-lucide="award" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold">Alhamdulillah! Semua Tugas Selesai!</p>
                            <p class="text-xs text-emerald-700">Terima kasih telah menjaga kebersihan lingkungan pondok hari ini.</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Toast Notifikasi (Pengganti alert() yang ramah pengguna) -->
        <div id="toast" class="fixed bottom-5 right-5 bg-forest-900 text-cream-50 px-4 py-3 rounded-2xl shadow-lg border border-forest-700 flex items-center gap-2.5 text-sm font-medium transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none z-50">
            <i data-lucide="info" class="w-4 h-4 text-amber-300"></i>
            <span id="toast-message">Pesan notifikasi</span>
        </div>

    </main>

    <!-- =====================================================================
         3. LOGIKA JAVASCRIPT (Data Contoh, State Management, & Interaksi)
         ===================================================================== -->
    <script>
        /**
         * DATA CONTOH JADWAL PIKET SANTRI (SENIN - SABTU)
         * Disimpan dalam bentuk objek terstruktur agar mudah dipelajari siswa pemula.
         */
        const jadwalPiketData = {
            Senin: {
                hari: "Senin",
                badge: "Kelompok 1",
                namaKelompok: "Kelompok Tahu Bulat",
                lokasi: "Masjid Utama & Serambi",
