                    { id: "jum-2", teks: "Menyiram tanaman hias di taman depan pondok", pj: "Jennie", selesai: false },
                    { id: "jum-3", teks: "Membersihkan saluran air/selokan dari sampah plastik", pj: "Halland", selesai: false },
                    { id: "jum-4", teks: "Mengumpulkan sampah taman ke bak sampah besar", pj: "Ronaldo", selesai: false }
                ]
            },
            Sabtu: {
                hari: "Sabtu",
                badge: "Kelompok 6",
                namaKelompok: "Kelompok Tahu Bulat",
                lokasi: "Aula Serbaguna & Lapangan Olahraga",
                deskripsiLokasi: "Area panggung aula, gudang alat olahraga, dan tribun santri.",
                anggota: ["Nirwasita Aileen", "Jennie", "Halland", "Ronaldo"],
                tugas: [
                    { id: "sab-1", teks: "Menyapu dan merapikan kursi di Aula Serbaguna", pj: "Nirwasita Aileen", selesai: false },
                    { id: "sab-2", teks: "Membersihkan area panggung dan meja podium", pj: "Jennie", selesai: false },
                    { id: "sab-3", teks: "Merapikan bola dan peralatan di gudang olahraga", pj: "Halland", selesai: true },
                    { id: "sab-4", teks: "Membersihkan sampah di sekitar lapangan olahraga", pj: "Ronaldo", selesai: false }
                ]
            }
        };

        // State untuk menyimpan hari yang sedang aktif dipilih
        let hariAktif = "Senin";
        let toastTimeout;

        /**
         * Fungsi untuk menampilkan notifikasi singkat di pojok kanan bawah
         */
        function tampilkanNotifikasi(pesan) {
            const toast = document.getElementById("toast");
            const toastMessage = document.getElementById("toast-message");
            
            toastMessage.textContent = pesan;
            toast.classList.remove("translate-y-20", "opacity-0");
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add("translate-y-20", "opacity-0");
            }, 2500);
        }

        /**
         * Merender tombol navigasi hari (Senin - Jumat) pada sidebar
         */
        function renderNavigasiHari() {
            const navContainer = document.getElementById("day-navigation");
            navContainer.innerHTML = "";

            const daftarHari = Object.keys(jadwalPiketData);

            daftarHari.forEach((hari) => {
                const isAktif = hari === hariAktif;
                const button = document.createElement("button");
                button.type = "button";
                
                // Styling berbeda untuk hari yang sedang aktif vs tidak aktif
                if (isAktif) {
                    button.className = "w-full flex items-center justify-center lg:justify-between px-3 py-2.5 lg:px-4 lg:py-3 rounded-xl font-bold text-sm bg-cream-50 text-forest-900 shadow-sm transition-all cursor-pointer";
                } else {
                    button.className = "w-full flex items-center justify-center lg:justify-between px-3 py-2.5 lg:px-4 lg:py-3 rounded-xl font-medium text-sm text-cream-200 hover:bg-forest-800 hover:text-cream-50 transition-all cursor-pointer";
                }

                // Tampilan teks responsif: 3 huruf pertama di HP kecil, nama penuh di desktop
                button.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <i data-lucide="calendar" class="w-4 h-4 hidden lg:inline-block ${isAktif ? 'text-forest-600' : 'text-forest-600'}"></i>
                        <span class="hidden sm:inline">${hari}</span>
                        <span class="sm:hidden">${hari.substring(0, 3)}</span>
                    </div>
                    <span class="hidden lg:inline-block text-xs px-2 py-0.5 rounded-md ${isAktif ? 'bg-forest-100 text-forest-800' : 'bg-forest-800 text-cream-200'}">
                        ${jadwalPiketData[hari].badge.replace('Kelompok ', 'K')}
                    </span>
                `;

                button.addEventListener("click", () => {
                    hariAktif = hari;
                    renderSemua();
                });

                navContainer.appendChild(button);
            });
        }

        /**
         * Merender informasi kelompok, lokasi piket, dan daftar anggota
         */
        function renderInfoKelompok() {
            const data = jadwalPiketData[hariAktif];

            document.getElementById("header-day-name").textContent = data.hari;
            document.getElementById("group-badge").textContent = data.badge;
            document.getElementById("group-name").textContent = data.namaKelompok;
            document.getElementById("group-location").textContent = data.lokasi;
            document.getElementById("group-location-desc").textContent = data.deskripsiLokasi;

            const memberList = document.getElementById("member-list");
            memberList.innerHTML = "";

            data.anggota.forEach((nama) => {
                // Mengambil inisial nama untuk avatar bulat
                const inisial = nama.split(" ").map(n => n[0]).join("").substring(0, 2);
                const div = document.createElement("div");
                div.className = "flex items-center gap-2.5 bg-cream-100/70 border border-cream-200 px-3 py-2 rounded-xl";
                div.innerHTML = `
                    <div class="w-7 h-7 rounded-full bg-forest-700 text-cream-50 text-xs font-bold flex items-center justify-center flex-shrink-0">
                        ${inisial}
                    </div>
                    <span class="text-xs font-semibold text-forest-900 truncate">${nama}</span>
                `;
                memberList.appendChild(div);
            });
        }

        /**
         * Merender checklist tugas dan memperbarui statistik (selesai & belum selesai)
         */
        function renderChecklistDanStatistik() {
            const data = jadwalPiketData[hariAktif];
            const taskList = document.getElementById("task-list");
            taskList.innerHTML = "";

            // Hitung jumlah tugas
            const totalTugas = data.tugas.length;
            const tugasSelesai = data.tugas.filter(t => t.selesai).length;
            const tugasBelumSelesai = totalTugas - tugasSelesai;
            const persentase = totalTugas === 0 ? 0 : Math.round((tugasSelesai / totalTugas) * 100);

            // Perbarui kartu statistik
            document.getElementById("stat-total").textContent = totalTugas;
            document.getElementById("stat-completed").textContent = tugasSelesai;
            document.getElementById("stat-pending").textContent = tugasBelumSelesai;

            // Perbarui progress bar
            document.getElementById("progress-text").textContent = `${persentase}% (${tugasSelesai}/${totalTugas})`;
            document.getElementById("progress-bar").style.width = `${persentase}%`;

            // Tampilkan atau sembunyikan banner ucapan selamat jika 100% selesai
            const allDoneBanner = document.getElementById("all-done-banner");
            if (tugasSelesai === totalTugas && totalTugas > 0) {
                allDoneBanner.classList.remove("hidden");
            } else {
                allDoneBanner.classList.add("hidden");
            }

            // Render setiap item tugas ke dalam daftar checklist
            data.tugas.forEach((item, index) => {
                const taskItem = document.createElement("div");
                taskItem.setAttribute("role", "listitem");
                
                // Styling berbeda jika tugas sudah dicentang selesai
                taskItem.className = `group flex items-start gap-3.5 p-3.5 rounded-2xl border transition-all cursor-pointer select-none ${
                    item.selesai 
                    ? "bg-emerald-50/60 border-emerald-200/80" 
                    : "bg-white border-cream-200 hover:border-forest-600 hover:shadow-sm"
                }`;

                taskItem.innerHTML = `
                    <div class="pt-0.5">
                        <div class="w-6 h-6 rounded-lg flex items-center justify-center border-2 transition-colors ${
                            item.selesai 
                            ? "bg-emerald-600 border-emerald-600 text-white" 
                            : "border-cream-300 group-hover:border-forest-600 bg-cream-50"
                        }">
                            ${item.selesai ? '<i data-lucide="check" class="w-4 h-4 stroke-[3]"></i>' : ''}
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold transition-all ${
                            item.selesai ? "line-through text-forest-600/70" : "text-forest-900"
                        }">
                            ${item.teks}
                        </p>
                        <div class="flex items-center gap-1.5 mt-1">
                            <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-md ${
                                item.selesai ? "bg-emerald-100/70 text-emerald-800" : "bg-cream-100 text-forest-700"
                            }">
                                <i data-lucide="user" class="w-3 h-3"></i>
                                PJ: ${item.pj}
                            </span>
                        </div>
                    </div>
                `;

                // Event listener saat baris tugas diklik untuk toggle status selesai
                taskItem.addEventListener("click", () => {
                    jadwalPiketData[hariAktif].tugas[index].selesai = !item.selesai;
                    renderChecklistDanStatistik();
                    lucide.createIcons(); // Render ulang ikon Lucide
                });

                taskList.appendChild(taskItem);
            });
        }

        /**
         * Event listener untuk tombol Reset Checklist
         */
        document.getElementById("btn-reset").addEventListener("click", () => {
            const daftarTugas = jadwalPiketData[hariAktif].tugas;
            const adaYangSelesai = daftarTugas.some(t => t.selesai);

            if (!adaYangSelesai) {
                tampilkanNotifikasi(`Checklist hari ${hariAktif} sudah dalam keadaan kosong.`);
                return;
            }

            // Mengubah semua status tugas pada hari aktif menjadi false (belum selesai)
            daftarTugas.forEach(tugas => {
                tugas.selesai = false;
            });

            renderChecklistDanStatistik();
            lucide.createIcons();
            tampilkanNotifikasi(`Checklist hari ${hariAktif} berhasil di-reset!`);
        });

        /**
         * Fungsi utama untuk merender seluruh komponen antarmuka
         */
        function renderSemua() {
            renderNavigasiHari();
            renderInfoKelompok();
            renderChecklistDanStatistik();
            // Inisialisasi ikon Lucide setiap kali DOM diperbarui
            lucide.createIcons();
        }

        // Jalankan aplikasi saat halaman selesai dimuat
        window.addEventListener("DOMContentLoaded", () => {
            renderSemua();
        });
    </script>
</body>
</html>
